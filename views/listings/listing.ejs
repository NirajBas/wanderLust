<% layout("/layouts/boilerplate.ejs") %>

    <body>

        <div class="container mt-5 mb-5">

            <div class="row justify-content-center">

                <div class="col-lg-8">

                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                        <!-- Hotel Image -->
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="hotel_image"
                            style="height: 20rem; object-fit: cover;">

                        <!-- Hotel Details -->
                        <div class="card-body p-4">

                            <h1 class="fw-bold mb-4">
                                <%= listing.title %>
                            </h1>

                            <p class="text-muted fs-5 mb-4">
                                <%= listing.description %>
                            </p>

                            <div class="mb-3 fs-5">
                                <span class="fw-semibold">Price:</span>
                                ₹<%= listing.price.toLocaleString("en-IN") %>
                            </div>

                            <div class="mb-3 fs-5">
                                <span class="fw-semibold">Location:</span>
                                <%= listing.location %>
                            </div>

                            <div class="mb-4 fs-5">
                                <span class="fw-semibold">Country:</span>
                                <%= listing.country %>
                            </div>

                            <!-- Buttons -->
                            <% if (checkUser && listing.owner && listing.owner._id.equals(checkUser._id)) { %>
                            <div class="d-flex gap-3">

                                <a href="/listings/<%= listing._id %>/edit"
                                    class="btn btn-outline-dark px-4 rounded-pill">
                                    Edit Hotel
                                </a>

                                <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">

                                    <button class="btn btn-dark px-4 rounded-pill">
                                        Delete Hotel
                                    </button>

                                </form>

                            </div>
                            <% } %>


                            <div class="col-8">
                                <hr class="my-4">

                                <% if (checkUser) { %>
                                <h4 class="mb-3">Leave a review</h4>
                                <form method= "post" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
                                    <div class="mb-3">
                                        <label for="rating" class="form-label">Rating</label>
                                        <input type="range" min="1" max="5" id="rating" name="review[rating]"
                                            class="form-range">
                                    </div>
                                    <div class="mb-3">
                                        <label for="comments" class="form-label">Comments</label>
                                        <textarea name="review[comments]" id="comments" rows="5"
                                            class="form-control" required></textarea>
                                            <div class="invalid-feedback">Please add some comments for review</div>
                                    </div>
                                    <button class="btn btn-outline-dark">Submit</button>
                                </form>
                                <hr>
                                <% } %>
                                <h4 class="mb-3">All Reviews</h4>

                                <% if (!listing.reviews || listing.reviews.length === 0) { %>
                                    <p class="text-muted">No reviews yet. Be the first to leave one.</p>
                                <% } else { %>
                                    <div class="row g-3">
                                        <% for (let review of listing.reviews) { %>
                                            <div class="col-md-6">
                                                <div class="card review-card h-100 rounded-3">
                                                    <div class="card-body">
                                                        <p class="star-rating mb-2">
                                                            <% for (let i = 1; i <= 5; i++) { %>
                                                                <% if (i <= review.rating) { %>
                                                                    <i class="fa-solid fa-star"></i>
                                                                <% } else { %>
                                                                    <i class="fa-regular fa-star"></i>
                                                                <% } %>
                                                            <% } %>
                                                            <span class="text-muted ms-1"><%= review.rating %>/5</span>
                                                        </p>
                                                        <p class="fw-semibold mb-1">@<%= review.author ? review.author.username : "Anonymous" %></p>
                                                        <p class="card-text mb-2"><%= review.comments %></p>
                                                        <% if (review.createdAt) { %>
                                                            <p class="text-muted small mb-3">
                                                                <%= review.createdAt.toLocaleDateString("en-IN") %>
                                                            </p>
                                                        <% } %>
                                                        <% if (checkUser && review.author && review.author._id.equals(checkUser._id)) { %>
                                                        <form method="post"
                                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                            <button class="btn btn-sm btn-dark rounded-pill">
                                                                Delete
                                                            </button>
                                                        </form>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </body>